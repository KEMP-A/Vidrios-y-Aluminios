:root{
--negro:#111;--gris:#2b2b2b;--plata:#c9c9c9;--blanco:#fff;--fondo:#f7f7f5;
--transition: .3s ease;
}

/* Reset y base */
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;color:var(--negro);background:var(--blanco);line-height:1.6;}
h1,h2,h3{font-family:'Playfair Display',serif;}
a{text-decoration:none;color:inherit;}
img{display:block;max-width:100%;height:auto;}
img{width:100%;height:auto;}

/* Contenedor principal */
.container{width:min(1200px,95%);margin:0 auto;}

/* Tipografía responsiva */
h1{font-size:clamp(38px,4vw,60px);margin-bottom:1.5rem;}
h2{font-size:clamp(32px,3.5vw,40px);margin-bottom:1.2rem;}
h3{font-size:clamp(22px,2.5vw,28px);margin-bottom:1rem;}
p{font-size:clamp(14px,1.5vw,16px);line-height:1.7;}

/* Header */
header{position:fixed;top:0;width:100%;z-index:100;transition:.3s;background:rgba(17,17,17,.0);}
header.scrolled{background:rgba(17,17,17,.92);backdrop-filter:blur(8px);}
nav{display:flex;justify-content:space-between;align-items:center;padding:20px 0;}
.logo{color:#fff;font-family:'Playfair Display',serif;font-size:24px;letter-spacing:2px;}
.nav-links{display:flex;gap:32px;align-items:center;list-style:none;}
.nav-links a{color:#eee;font-size:14px;letter-spacing:1px;text-transform:uppercase;transition:.3s;position:relative;padding-bottom:4px;}
.nav-links a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--plata);transition:.3s;}
.nav-links a:hover::after{width:100%;}
.nav-links a:hover{color:var(--plata);}
.nav-cta{border:1px solid #fff;color:#fff;padding:12px 24px;}
.nav-cta:hover{background:#fff;color:var(--negro);}
#menuToggle{display:none;background:none;border:none;color:#fff;font-size:24px;cursor:pointer;}

/* Hero */
.hero{height:100vh;background:linear-gradient(135deg,#111 0%,#2b2b2b 100%);display:flex;align-items:center;position:relative;}
.hero::after{content:'';position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.35));}
.hero .container{position:relative;z-index:2;color:#fff;}
.hero h1{font-size:clamp(42px,6vw,72px);margin-bottom:14px;letter-spacing:2px;}
.hero h2{color:#fff;font-size:clamp(22px,3vw,32px);font-weight:400;margin-bottom:18px;letter-spacing:.5px;}
.hero p{max-width:560px;margin-bottom:34px;color:#ddd;line-height:1.7;}
.hero-btns{display:flex;gap:20px;flex-wrap:wrap;align-items:center;}
.hero-btns .btn{padding:14px 32px;font-size:14px;}

/* Nosotros */
.about{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.about img{width:100%;height:auto;max-height:500px;object-fit:cover;filter:grayscale(15%);}
.about h2{font-size:clamp(28px,3vw,36px);margin-bottom:1rem;}
.about p{font-size:15px;color:#555;}

/* Why */
.why{background:var(--negro);color:#fff;}
.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:30px;margin-top:40px;}
.why-item{border-left:2px solid var(--plata);padding-left:20px;}
.why-item h3{margin-bottom:8px;font-size:15px;}
.why-item p{color:#aaa;font-size:13px;}

/* Servicios */
#servicios{background:var(--fondo);}
.grid-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-top:40px;}
.card{background:#fff;overflow:hidden;transition:.4s;border:1px solid #eee;}
.card img{width:100%;height:180px;object-fit:cover;transition:.4s;}
.card:hover{transform:translateY(-8px);box-shadow:0 15px 35px rgba(0,0,0,.1);border-color:#ddd;}
.card:hover img{transform:scale(1.03);}
.card-body{padding:20px;}
.card-body h3{margin-bottom:8px;font-size:18px;position:relative;padding-bottom:8px;}
.card-body h3::after{content:'';display:block;width:35px;height:1.5px;background:var(--plata);margin:6px auto 0;}
.card-body p{font-size:13px;color:#555;}

/* Why section items */
.why-item{border-left:2px solid var(--plata);padding-left:20px;position:relative;}
.why-item::before{content:'';position:absolute;left:-7px;top:0;width:10px;height:10px;background:var(--plata);border-radius:50%;opacity:.3;transition:.3s;}
.why-item:hover::before{opacity:1;transform:scale(1.3);}
.why-item h3{margin-bottom:8px;font-size:15px;}
.why-item p{color:#aaa;font-size:13px;}

/* Video presentacion */
.video-destacado{width:min(900px,100%);margin:40px auto 0;display:block;border-radius:8px;background:#000;}
.video-destacado video{width:100%;border-radius:8px;}

/* Videos */
.videos-sec{padding:80px 0;}
.vcar{max-width:1100px;margin:0 auto;}
.vcar-track{display:flex;gap:24px;transition:.5s ease;}
.vcar-track video{flex:0 0 33.333%;width:33.333%;border-radius:8px;background:#000;}
@media(max-width:850px){.vcar-track video{flex:0 0 100%;width:100%;}} 

/* Galería */
.galeria{padding:80px 0;}
.galeria .container{max-width:1200px;margin:0 auto;}
.galeria .masonry{columns:3 260px;column-gap:20px;margin-top:40px;break-inside:avoid;}
.galeria .masonry img{width:100%;margin-bottom:18px;cursor:pointer;transition:.35s;border-radius:4px;}
.galeria .masonry img:hover{transform:scale(1.03);filter:brightness(1.1);}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;z-index:200;}
.lightbox img{max-width:90%;max-height:85%;}
.lightbox.open{display:flex}
#closeLb{position:absolute;top:20px;right:25px;color:#fff;font-size:32px;cursor:pointer;background:none;border:none;}

/* Servicios */
#servicios{background:var(--fondo);}
.grid-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-top:40px;}
.card{background:#fff;overflow:hidden;transition:.4s;border:1px solid #eee;}
.card img{width:100%;height:180px;object-fit:cover;transition:.5s;}
.card:hover{transform:translateY(-8px);box-shadow:0 15px 35px rgba(0,0,0,.1);border-color:#ddd;}
.card:hover img{transform:scale(1.05);}
.card-body{padding:20px;}
.card-body h3{margin-bottom:8px;font-size:18px;position:relative;padding-bottom:8px;}
.card-body h3::after{content:'';display:block;width:35px;height:1.5px;background:var(--plata);margin:6px auto 0;}
.card-body p{font-size:13px;color:#555;}

/* Galería de Proyectos */
.galeria{padding:80px 0;}
.galeria .container{max-width:1200px;margin:0 auto;}
.galeria .masonry{columns:3 260px;column-gap:20px;margin-top:40px;break-inside:avoid;}
.galeria .masonry img{width:100%;margin-bottom:18px;cursor:pointer;transition:.35s;border-radius:4px;}
.galeria .masonry img:hover{transform:scale(1.03);filter:brightness(1.1);}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;z-index:200;}
.lightbox img{max-width:90%;max-height:85%;}
.lightbox.open{display:flex}
#closeLb{position:absolute;top:20px;right:25px;color:#fff;font-size:32px;cursor:pointer;background:none;border:none;}

/* CTA */
.cta{background:linear-gradient(135deg,#1a1a1a,#333);text-align:center;color:#fff;position:relative;padding:60px 0;}
.cta .container{position:relative;z-index:2;}
.cta h2{color:#fff;margin-bottom:20px;}
.cta .container h2::after{content:'';position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:60px;height:3px;background:var(--plata);}

/* Ubicación */
.mapa{background:#f7f7f5;padding:60px 0;}
.map-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:30px;align-items:center;}
.map-wrap iframe{width:100%;height:400px;border:0;display:block;}
.map-info h3{font-size:22px;margin-bottom:15px;}
.map-info p{color:#555;line-height:1.6;}
.map-link a{display:inline-block;padding:10px 20px;background:#fff;color:#111;border-radius:4px;text-decoration:none;}

/* Contacto */
.contacto{padding:80px 0;}
.contacto .container{max-width:1100px;margin:0 auto;}
.contacto .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:40px;}
.contacto .contacto .formulario{background:#f8f8f8;padding:30px;}
.contacto .formulario input,.contacto .formulario select,.contacto .formulario textarea{width:100%;padding:12px;margin-bottom:15px;border:1px solid #ddd;font-family:inherit;background:#fff;}
.contacto .formulario input:focus,.contacto .formulario textarea:focus{outline:none;border-color:var(--negro);}
.contacto .formulario .btn-enviar{width:100%;padding:15px;background:#111;color:#fff;border:none;cursor:pointer;}
.contacto .social-btns a{display:inline-block;margin:6px 8px 6px 0;padding:8px 16px;border:1px solid var(--negro);font-size:12px;letter-spacing:1px;text-transform:uppercase;transition:.3s;}
.contacto .social-btns a:hover{background:var(--negro);color:#fff;}
.contacto .contacto .info p{color:#555;font-size:14px;margin:10px 0;}

/* Footer */
footer{background:var(--negro);color:#aaa;padding:50px 0 30px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;}
.footer a{display:block;margin-bottom:12px;font-size:14px;color:#fff;transition:.3s;}
.footer a:hover{color:#fff;}
.footer .footer-brand{color:#fff;margin-bottom:15px;font-family:'Playfair Display',serif;}
.footer .footer-title{color:#fff;margin-bottom:15px;}
.footer .footer-contact{font-size:13px;margin-top:20px;color:#777;}
.footer-bottom{margin-top:30px;border-top:1px solid #333;padding-top:20px;font-size:12px;text-align:center;color:#777;}

/* WhatsApp flotante */
#waWrap{position:fixed;bottom:30px;right:30px;z-index:150;text-align:right;}
#waFloat{width:56px;height:56px;background:#25D366;border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.3);transition:.3s;}
#waFloat:hover{transform:scale(1.1);}

/* Lightbox */
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;z-index:200;}
.lightbox img{max-width:90%;max-height:85%;}

/* Transiciones */
*,*::before,*::after{transition:.3s ease;}

/* Responsivo principal */
@media(max-width:1920px){.about{grid-template-columns:1fr 1fr;}}
@media(max-width:1440px){.grid-services{grid-template-columns:repeat(auto-fit,minmax(240px,1fr));}}
@media(max-width:1024px){.footer-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:768px){.about{grid-template-columns:1fr;}.footer-grid{grid-template-columns:1fr;}.grid-services{grid-template-columns:1fr;}}
@media(max-width:600px){.about img{max-height:400px;}.why-grid{grid-template-columns:1fr;}.contacto .contacto .contacto{grid-template-columns:1fr;}}
@media(max-width:480px){.nav-links{display:none;position:absolute;top:70px;left:0;width:100%;background:#111;flex-direction:column;padding:20px;}.nav-links.open{display:flex}.nav-links a{width:100%;border-bottom:1pxsolid #222;padding:12px 0;}.nav-cta{width:100%;text-align:center;margin-top:10px;}.footer-grid{grid-template-columns:1fr;}.footer .footer-brand{margin-bottom:20px;}}

@media(max-width:375px){.about img{max-height:350px;}.footer .footer-brand h3{font-size:20px;}.footer .footer-title{font-size:18px;}}

@media(max-width:320px){.footer .footer-brand h3{font-size:18px;}.footer .footer-title{font-size:16px;}.footer .footer-contact p{font-size:12px;}}